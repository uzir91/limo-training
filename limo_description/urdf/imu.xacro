<?xml version="1.0"?>

<robot name="imu" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="imu" params="object_name:='imu' topic='imu/data' frame_link='imu_link' parent_link:='base_link' xyz:='0 0 0' rpy:='0 0 0'">
        <xacro:property
            name="mass"
            value="0.01"/>
        <xacro:property
            name="x"
            value="0.03"/>
        <xacro:property
            name="y"
            value="0.02"/>
        <xacro:property
            name="z"
            value="0.01"/>
        <xacro:property
            name="M_PI"
            value="3.1415926536"/>
        
        <link
            name="${frame_link}">
            <inertial>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <mass
                    value="${mass}"/>
                <inertia
                    ixx="${mass * (y * y + z * z) / 12.0}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${mass * (x * x + z * z) / 12.0}"
                    iyz="0.0"
                    izz="${mass * (x * x + y * y) / 12.0}"/>
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <box
                        size="${x} ${y} ${z}"/>
                </geometry>
                <material
                    name="${object_name}_material">
                    <color
                        rgba="1 0.5 0 1"/>
                    <texture
                        filename=""/>
                </material>
                <material name="black"/>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <box
                        size="${x} ${y} ${z}"/>
                </geometry>
            </collision>
        </link>

        <joint
            name="${object_name}_joint"
            type="fixed">
            <origin
                xyz="${xyz}"
                rpy="${rpy}"/>
            <parent
                link="${parent_link}"/>
            <child
                link="${frame_link}"/>
        </joint>

        <gazebo reference="${frame_link}">
            <gravity>true</gravity>

            <visual>
                <material>
                    <ambient>1.0 0.4 0.0 1.0</ambient>
                    <diffuse>1.0 0.4 0.0 1.0</diffuse>
                    <specular>0.1 0.1 0.1 1.0</specular>
                </material>
            </visual>

            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.8</mu>
                            <mu2>0.8</mu2>
                        </ode>
                    </friction>

                    <contact>
                        <ode>
                            <kp>1000000.0</kp>
                            <kd>1.0</kd>
                            <max_vel>0.0</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
            </collision>

            <sensor
                name="${object_name}_sensor"
                type="imu">

                <pose>0 0 0 0 0 0</pose>

                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <visualize>false</visualize>

                <topic>${topic}</topic>
                <gz_frame_id>${frame_link}</gz_frame_id>

                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>

                                <bias_mean>0.000</bias_mean>
                                <bias_stddev>0.000</bias_stddev>
                            </noise>
                        </x>

                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>

                                <bias_mean>0.000</bias_mean>
                                <bias_stddev>0.000</bias_stddev>
                            </noise>
                        </y>

                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>

                                <bias_mean>0.000</bias_mean>
                                <bias_stddev>0.000</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>

                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>
                            </noise>
                        </x>

                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>
                            </noise>
                        </y>

                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0001</stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
<?xml version="1.0"?>

<robot name="imu" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="imu" params="object_name:='imu' topic='imu/data' frame_link='imu_link' parent_link:='base_link' xyz:='0 0 0' rpy:='0 0 0'">
        <xacro:property
            name="mass"
            value="0.01"/>
        <xacro:property
            name="x"
            value="0.03"/>
        <xacro:property
            name="y"
            value="0.02"/>
        <xacro:property
            name="z"
            value="0.01"/>
        <xacro:property
            name="M_PI"
            value="3.1415926536"/>
        
        <link
            name="${frame_link}">
            <inertial>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <mass
                    value="${mass}"/>
                <inertia
                    ixx="${mass * (y * y + z * z) / 12.0}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${mass * (x * x + z * z) / 12.0}"
                    iyz="0.0"
                    izz="${mass * (x * x + y * y) / 12.0}"/>
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <box
                        size="${x} ${y} ${z}"/>
                </geometry>
                <material
                    name="${object_name}_material">
                    <color
                        rgba="1 0.5 0 1"/>
                    <texture
                        filename=""/>
                </material>
                <material name="black"/>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <box
                        size="${x} ${y} ${z}"/>
                </geometry>
            </collision>
        </link>

        <joint
            name="${object_name}_joint"
            type="fixed">
            <origin
                xyz="${xyz}"
                rpy="${rpy}"/>
            <parent
                link="${parent_link}"/>
            <child
                link="${frame_link}"/>
        </joint>

        <gazebo reference="${frame_link}">
            <material>Gazebo/Orange</material>
            <gravity>true</gravity>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
            <maxVel>0.0</maxVel>
            <minDepth>0.001</minDepth>

            <sensor name="${object_name}_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <plugin name="${object_name}_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>${object_name}_plugin/out:=${topic}</remapping>
                    </ros>
                    <update_rate>100</update_rate>
                    <gaussian_noise>0.0001</gaussian_noise>
                    <frame_name>${frame_link}</frame_name>
                </plugin>
                <pose>0 0 0 0 0 0</pose>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
<?xml version="1.0"?>

<robot name="hardware_control" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="ros2_control" params="namespace:='limo' controller_manager_path:='$(find limo_description)/config/controller_manager.yaml'">
        <ros2_control name="ros2_control_system" type="system">
            <hardware>
                <plugin>fake_components/GenericSystem</plugin>
            </hardware>

            <joint name="wheel_front_left_joint">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <command_interface name="position"/>
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
            </joint>

            <joint name="wheel_front_right_joint">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <command_interface name="position"/>
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
            </joint>

            <joint name="wheel_rear_left_joint">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <command_interface name="position"/>
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
            </joint>

            <joint name="wheel_rear_right_joint">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <command_interface name="position"/>
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
            </joint>
        </ros2_control>
    </xacro:macro>

</robot>

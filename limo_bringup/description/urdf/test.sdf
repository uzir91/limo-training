<?xml version="1.0"?>
<sdf version="1.7">
    <model name="mybot_control_host">
        <link name="base_link">
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.01</ixx>
                    <iyy>0.01</iyy>
                    <izz>0.01</izz>
                </inertia>
            </inertial>
            <visual name="base_vis">
                <geometry>
                    <box>
                        <size>0.3 0.3 0.1</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                </material>
            </visual>
        </link>

        <link name="child_link">
            <pose>0.2 0 0.1 0 0 0</pose>
            <inertial>
                <mass>0.5</mass>
                <inertia>
                    <ixx>0.005</ixx>
                    <iyy>0.005</iyy>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="child_vis">
                <geometry>
                    <cylinder>
                        <radius>0.05</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                </material>
            </visual>
        </link>

        <joint name="base_to_child" type="fixed">
            <parent>base_link</parent>
            <child>child_link</child>
        </joint>

        <plugin name="ign_ros2_control::IgnitionROS2ControlPlugin" filename="libign_ros2_control-system.so">
        </plugin>
    </model>
</sdf>

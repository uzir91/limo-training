<?xml version="1.0"?>

<robot name="ydlidar" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="ydlidar" params="object_name:='ydlidar' topic='scan' frame_link='ydlidar_link' parent_link:='base_link' xyz:='0 0 0' rpy:='0 0 0'">
        <xacro:property
            name="mass"
            value="0.1"/>
        <xacro:property
            name="radius"
            value="0.03"/>
        <xacro:property
            name="height"
            value="0.014"/>
        <xacro:property
            name="M_PI"
            value="3.1415926536"/>

        <link
            name="${frame_link}">
            <inertial>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <mass
                    value="${mass}"/>
                <inertia
                    ixx="${( 3 * radius * radius + height * height ) / 12.0}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${( 3 * radius * radius + height * height ) / 12.0}"
                    iyz="0.0"
                    izz="${radius * radius / 2.0}"/>
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <cylinder
                        radius="${radius}"
                        length="${height}"/>
                </geometry>
                <material
                    name="${object_name}_material">
                    <color
                        rgba="0 0 1 1"/>
                    <texture
                        filename=""/>
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <geometry>
                    <cylinder
                        radius="${radius}"
                        length="${height}"/>
                </geometry>
            </collision>
        </link>

        <joint
            name="${object_name}_joint"
            type="fixed">
            <origin
                xyz="${xyz}"
                rpy="${rpy}"/>
            <parent
                link="${parent_link}"/>
            <child
                link="${frame_link}"/>
        </joint>

        <gazebo reference="${frame_link}">
            <sensor name="${object_name}_sensor" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>

                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>10</update_rate>

                <topic>${topic}</topic>
                <gz_frame_id>${frame_link}</gz_frame_id>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>461</samples>
                            <resolution>1</resolution>
                            <min_angle>${-M_PI}</min_angle>
                            <max_angle>${M_PI}</max_angle>
                        </horizontal>
                    </scan>

                    <range>
                        <min>0.3</min>
                        <max>15.0</max>
                        <resolution>0.015</resolution>
                    </range>

                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
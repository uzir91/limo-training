# from launch_ros.parameter_descriptions import ParameterValue


from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, OpaqueFunction, IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node

def generate_context(context, *args, **kwargs):
    # --- Resolve arguments ---
    GetArgument = context.launch_configurations.get
    FindPackage = get_package_share_directory

    simulation = GetArgument('simulation', 'false').lower() in ['true', '1', 'yes']
    rviz = GetArgument('rviz', 'true').lower() in ['true', '1', 'yes']
    gui = GetArgument('gui', 'false').lower() in ['true', '1', 'yes']
    rviz_config = GetArgument('rviz_config', 'bringup.rviz')
    world_config = GetArgument('world_config', 'mrworld_adr_obstacle.world')
    controller_sim = GetArgument('controller_simulation_config', 'simulation.yaml')
    controller_hw = GetArgument('controller_hardware_config', 'hardware.yaml')

    limo_bringup_pkg = FindPackage('limo_bringup')
    limo_description_pkg = FindPackage('limo_description')
    gazebo_pkg = FindPackage('gazebo_ros')
    world_path = join(limo_bringup_pkg, 'worlds', world_config)
    rviz_path = join(limo_bringup_pkg, 'rviz', rviz_config)
    controller_path = join(limo_bringup_pkg, 'cfg', controller_sim if simulation else controller_hw)
    limo_description_launch = join(limo_description_pkg, 'launch', 'limo_description.launch.py')
    gazebo_launch = join(gazebo_pkg, 'launch', 'gazebo.launch.py')

    actions = []

    if simulation:
        # --- GAZEBO (Sim) ---
        actions.append(
            Node(
                package='gazebo_ros',
                executable='spawn_entity.py',
                output='screen',
                arguments=['-entity', 'limo', '-topic', 'robot_description'],
                parameters=[{'use_sim_time': True}]
            )
        )
    # else:
    #     # --- Hardware ---
    #     actions.append(
    #         Node(
    #             package='controller_manager',
    #             executable='ros2_control_node',
    #             output='screen',
    #             parameters=[
    #                 {'use_sim_time': False},
    #                 controller_path
    #             ],
    #             remappings=[('~/robot_description', '/robot_description')]
    #         )
    #     )
    
    actions.append(
        Node(
            package='controller_manager',
            executable='ros2_control_node',
            output='screen',
            parameters=[
                {'use_sim_time': False},
                controller_path
            ],
            remappings=[('~/robot_description', '/robot_description')]
        )
    )

    actions.append(
        Node(
            package='controller_manager',
            executable='spawner',
            arguments=[
                'joint_state_broadcaster',
                '-c', '/controller_manager',
                '-p', controller_path
            ],
            output='screen',
            parameters=[{'use_sim_time': True}]
        )
    )

    actions.append(
        Node(
            package='controller_manager',
            executable='spawner',
            arguments=[
                'diff_drive_controller',
                '-c', '/controller_manager',
                '-p', controller_path
            ],
            output='screen',
            parameters=[{'use_sim_time': True}]
        )
    )

    if rviz:
        actions.append(
            Node(
                name='rviz2_node',
                package='rviz2',
                executable='rviz2',
                output='screen',
                parameters=[{'use_sim_time': simulation}],
                arguments=['-d', rviz_path]
            )
        )

    # --- Include limo_description (always included, disables its rviz & joint state stuff) ---
    actions.append(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                limo_description_launch
            ),
            launch_arguments={
                'simulation': str(simulation).lower(),
                'joint_state_enable': 'false',
                'joint_state_gui_enable': 'false',
                'rviz': 'false'
            }.items()
        )
    )

    if simulation:
        # --- GAZEBO (Sim) ---
        actions.append(
            IncludeLaunchDescription(
                PythonLaunchDescriptionSource(
                    gazebo_launch
                ),
                launch_arguments = {
                    'gui': 'true' if gui else 'false',
                    'world': world_path,
                    'use_sim_time': 'true'
                }.items()
            )
        )

    return actions

def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("simulation", default_value="false", description="true for simulation"),
        DeclareLaunchArgument("rviz", default_value="true", description="enable rviz"),
        DeclareLaunchArgument("gui", default_value="false", description="gazebo gui enable"),
        DeclareLaunchArgument("rviz_config", default_value="bringup.rviz", description="rviz filename"),
        DeclareLaunchArgument("world_config", default_value="mrworld_adr_obstacle.world", description="world filename"),
        DeclareLaunchArgument("controller_simulation_config", default_value="simulation.yaml", description="controller file for simulation"),
        DeclareLaunchArgument("controller_hardware_config", default_value="hardware.yaml", description="controller file for hardware"),
        OpaqueFunction(function=generate_context)
    ])




